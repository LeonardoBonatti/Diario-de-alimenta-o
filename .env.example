# --- Banco (Neon) — injetada automaticamente pela integração Neon da Vercel ---
# Localmente, copie de Vercel > Storage > (seu banco) > .env.local
DATABASE_URL=

# --- Auth.js (login com Google) ---
# AUTH_SECRET: string aleatória de 32+ bytes (ex.: gerada em https://generate-secret.vercel.app/32)
AUTH_SECRET=
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Cron (Vercel envia "Authorization: Bearer <CRON_SECRET>") ---
CRON_SECRET=

# --- E-mail (opcional; sem isso o relatório fica só na interface) ---
RESEND_API_KEY=
REPORT_EMAIL_FROM="Diário Alimentar <relatorio@seudominio.com>"
APP_URL=https://seu-app.vercel.app
