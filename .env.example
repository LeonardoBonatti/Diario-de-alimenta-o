# --- Banco (Neon) — injetada automaticamente pela integração Neon da Vercel ---
# Localmente, copie de Vercel > Storage > (seu banco) > .env.local
DATABASE_URL=

# --- Acesso (opcional, recomendado) ---
# Senha única para abrir o app. Sem ela, qualquer pessoa com o link acessa os dados.
APP_PASSWORD=

# --- Cron (Vercel envia "Authorization: Bearer <CRON_SECRET>") ---
CRON_SECRET=

# --- E-mail do resumo semanal (opcional; sem isso o relatório fica só no dashboard) ---
REPORT_EMAIL_TO=voce@exemplo.com
RESEND_API_KEY=
REPORT_EMAIL_FROM="Diário Alimentar <relatorio@seudominio.com>"
APP_URL=https://seu-app.vercel.app
